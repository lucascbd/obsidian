# CouchDB
COUCHDB_USER=admin
COUCHDB_PASSWORD=troque-esta-senha
COUCHDB_DB=obsidian-vault

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx

# Modelos disponíveis no OpenRouter:
# nousresearch/hermes-3-llama-3.1-70b  (~$0.40/M tokens) ← recomendado
# google/gemini-flash-1.5              (~$0.075/M tokens) ← mais barato
# anthropic/claude-3.5-sonnet          (~$3/M tokens)     ← mais poderoso
OPENROUTER_MODEL=nousresearch/hermes-3-llama-3.1-70b

# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=gere-uma-chave-aleatoria-aqui
