# ── Obsidian (ignis) ──────────────────────────────────────────────────────────
OBSIDIAN_VERSION=1.12.7
PUID=1000
PGID=1000

# Portas no host. Mude se já houver algo nessas portas (ex.: a stack antiga
# ainda rodando). O ChromaDB não é exposto no host (acesso só interno).
IGNIS_HOST_PORT=8080
AGENT_HOST_PORT=8090

# Vault padrão usado pelo agente quando nenhum é especificado (nome do
# subdiretório em ./vaults). Vazio = usa o primeiro subdiretório encontrado.
DEFAULT_VAULT=

# Modelo de embeddings local (fastembed) — custo zero de tokens.
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# ── LLM — Claude Agent SDK (assinatura Claude Pro) ──────────────────────────────
# Gere o token uma vez numa máquina com navegador:  claude setup-token
# (requer plano Pro/Max). Cole o token aqui. Validade ~1 ano.
# NÃO defina ANTHROPIC_API_KEY no ambiente — ela tem precedência e ignoraria este token.
CLAUDE_CODE_OAUTH_TOKEN=

# Modelo (alias do Claude Code): sonnet | opus | haiku | default. Padrão: sonnet.
ANTHROPIC_MODEL=sonnet

# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=gere-uma-chave-aleatoria-aqui
