# ── Obsidian (ignis) ──────────────────────────────────────────────────────────
OBSIDIAN_VERSION=1.12.7
PUID=1000
PGID=1000

# Vault padrão usado pelo agente quando nenhum é especificado (nome do
# subdiretório em ./vaults). Vazio = usa o primeiro subdiretório encontrado.
DEFAULT_VAULT=

# Modelo de embeddings local (fastembed) — custo zero de tokens.
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# ── LLM — Fase 1: OpenRouter (https://openrouter.ai/keys) ────────────────────────
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=nousresearch/hermes-3-llama-3.1-70b

# ── LLM — Fase 2: Claude Agent SDK ──────────────────────────────────────────────
# https://console.anthropic.com/ — necessário quando migrarmos o agente para o SDK.
ANTHROPIC_API_KEY=

# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=gere-uma-chave-aleatoria-aqui
