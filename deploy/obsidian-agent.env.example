# Copie para /etc/obsidian-agent.env (chmod 600) e preencha os segredos.
# Lido pelos serviços systemd obsidian-agent e obsidian-watcher.

# ── Caminhos (os MESMOS que o ignis monta no host) ──────────────────────────────
VAULT_ROOT=/data/compose/113/vaults
DATA_DIR=/data/compose/113/data

# ── ChromaDB (container publicado em 127.0.0.1:8000) ────────────────────────────
CHROMADB_HOST=127.0.0.1
CHROMADB_PORT=8000
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# ── Agente ──────────────────────────────────────────────────────────────────────
AGENT_PORT=8090
# Modelo: sonnet | opus | haiku
ANTHROPIC_MODEL=sonnet
# Token da assinatura Claude Pro (claude setup-token). NÃO definir ANTHROPIC_API_KEY.
CLAUDE_CODE_OAUTH_TOKEN=
# Chave dos endpoints do coletor (/api/ingest-email, /api/ingest-event, ...).
AGENT_API_KEY=
# Vault padrão (vazio = primeiro subdiretório de VAULT_ROOT).
DEFAULT_VAULT=
