[Unit]
Description=Mordomo do Conhecimento — agente (Flask + Claude Agent SDK)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__AGENT_HOME__/agent
EnvironmentFile=/etc/obsidian-agent.env
Environment=PYTHONPATH=__AGENT_HOME__
Environment=HOME=__AGENT_HOME__
Environment=PYTHONUNBUFFERED=1
UMask=0002
ExecStart=__AGENT_HOME__/.venv/bin/python app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
